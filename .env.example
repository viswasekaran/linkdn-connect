# Copy to .env and adjust. All values are optional.

# Where the local SQLite database and the browser session are stored (relative to backend/).
DB_PATH=../data/prospects.db
BROWSER_DATA_DIR=../browser-data

# Use an installed browser instead of Playwright's bundled Chromium (optional).
# BROWSER_EXECUTABLE=C:\Program Files\BraveSoftware\Brave-Browser\Application\brave.exe

# Safety limits. LinkedIn restricts accounts that send many invitations; keep these low.
MAX_INVITES_PER_RUN=20
MAX_INVITES_PER_DAY=20

# Share of each run reserved for "priority" roles (HR, recruiters, managers, leads, seniors).
# The rest goes to regular employees.
PRIORITY_SHARE=0.5

# Include broad keywords "manager" / "director" in the priority group.
INCLUDE_MANAGERS=true
